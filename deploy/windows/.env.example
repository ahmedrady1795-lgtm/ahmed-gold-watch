# Gold Watch for Windows. Keep secrets in .env ONLY (never commit/share).
# NO CREDIT CARD OR HOSTING ACCOUNT REQUIRED.
WEB_PORT=3000
ML_ENGINE_URL=
ML_RETRAIN_SECONDS=21600

# Structural forecasts 10s; independent paper scalping 5s.
LEARNING_INTERVAL_MS=10000
SCALP_PULSE_INTERVAL_MS=5000

# Optional non-sensitive API connections (leave blank to use free public feeds).
MT5_BRIDGE_TOKEN=
TRADING_ECONOMICS_API_KEY=
TWELVE_DATA_API_KEY=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=
