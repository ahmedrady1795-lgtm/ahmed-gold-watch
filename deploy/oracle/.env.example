# Copy this to deploy/oracle/.env and restrict its permissions to 600.
# This file is never committed with real credentials.
DATA_ROOT=/opt/gold-watch-data
WEB_PORT=3000

# Main analysis / learning loop; scalp paper pulse remains independent.
LEARNING_INTERVAL_MS=10000
SCALP_PULSE_INTERVAL_MS=5000
SCALP_PULSE_ENABLED=1

# Optional neural service is DISABLED in the default free tier stack.
# To activate: NEURAL_ENGINE_URL=http://neural:8000 and --profile neural.
NEURAL_ENGINE_URL=
ML_RETRAIN_SECONDS=21600

# Leave blank until a domain actually points at the Oracle instance.
SITE_DOMAIN=

# No live trades: this compose file hard-disables broker execution.
MT5_BRIDGE_TOKEN=
TRADING_ECONOMICS_API_KEY=
TWELVE_DATA_API_KEY=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=
