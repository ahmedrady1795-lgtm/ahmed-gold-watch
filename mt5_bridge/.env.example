SITE_URL=https://ahmed-gold-watch-production.up.railway.app
MT5_BRIDGE_TOKEN=put-the-same-long-random-token-used-in-the-site-secret
MT5_SYMBOL=XAUUSDm
LIVE_TRADING=false
SCALP_DEMO_MODE=true
SCALP_DEMO_POLL_SECONDS=1.0
SCALP_QUICK_MAX_HOLD_SECONDS=30
SCALP_QUICK_MIN_CONFIDENCE=66
SCALP_QUICK_TP_SPREAD_MULT=2.2
SCALP_QUICK_SL_SPREAD_MULT=1.6
SCALP_QUICK_LOCK_TRIGGER=1.35
SCALP_QUICK_GIVEBACK_SPREAD=0.65
RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.0
MAX_WEEKLY_LOSS_PCT=2.5
MAX_DRAWDOWN_PCT=3.0
MAX_CONSECUTIVE_LOSSES=3
MIN_MARGIN_LEVEL=300
MAX_OPEN_POSITIONS=1
MAX_SPREAD_POINTS=100
MAX_SIGNAL_SLIPPAGE_POINTS=150
MAX_TICK_AGE_MS=5000
MAX_PRECHECK_LATENCY_MS=1500
POLL_SECONDS=5
COOLDOWN_SECONDS=600
MT5_MAGIC=5601795

# Create this file at any time to stop new orders immediately:
# KILL_SWITCH_FILE=C:\AhmedGoldWatch\KILL_SWITCH
# Optional only if the terminal is not already logged in:
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

# Safety/market-data sync
ATTEMPT_COOLDOWN_SECONDS=90
MT5_CANDLE_PUSH_SECONDS=15
MT5_CANDLE_COUNT=300
